{
  "schemaVersion": 1,
  "id": "org.garminlinux.status",
  "name": "Garmin status",
  "version": "1.0.0",
  "author": "Garmin Linux Companion",
  "license": "MIT",
  "description": "Read-only Garmin USB count for the Omarchy bar. Click opens the shared companion launcher.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Garmin",
    "description": "Shows whether any Garmin USB storage is present and opens the companion.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 30,
      "commandTimeoutSec": 8
    },
    "schema": [
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 30
      },
      {
        "key": "commandTimeoutSec",
        "type": "integer",
        "label": "Status command timeout (seconds)",
        "min": 6,
        "max": 30,
        "step": 1,
        "defaultValue": 8
      }
    ]
  }
}
